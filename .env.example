# ---- LLM: вызывается только для «хвоста» (атрибуты, которые продавец, правила и NER не закрыли) ----
# auto (по умолчанию) — LLM включается, если задан ключ/адрес: LLM_* ниже или OPENAI_API_KEY / OPENAI_BASE_URL
#   (на ВМ хакатона ключ организаторов уже в окружении — ничего настраивать не нужно). true / false — принудительно.
# Без LLM всё работает на правилах и NER.
LLM_ENABLED=auto
# Свой провайдер — любой OpenAI-совместимый endpoint (без VPN). Если не задан — берутся OPENAI_* из окружения.
#   Локальная Ollama:          LLM_BASE_URL=http://127.0.0.1:11434/v1        LLM_MODEL=qwen3:4b-instruct
#   vLLM on-prem:              LLM_BASE_URL=http://<gpu-сервер>:8000/v1      LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   GigaChat (прокси gpt2giga): LLM_BASE_URL=http://localhost:8090/v1        LLM_MODEL=GigaChat
#   YandexGPT:                 LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1  LLM_MODEL=gpt://<folder>/yandexgpt-lite/latest
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# auto (по умолчанию) — первая подходящая модель из GET {base}/models, порядок — LLM_MODEL_PREFERENCE
# LLM_MODEL=qwen3:4b-instruct
# «Есть локальная LLM — используем, нет — работаем без неё» (так настроен docker compose)
# LLM_LOCAL_URL=http://127.0.0.1:11434/v1
# Какую модель скачает `docker compose --profile llm up` при первом старте (выбрана замером, docs/LLM.md)
# LLM_LOCAL_MODEL=qwen3:4b-instruct
# json_schema | json_object | none — с чего начинать; если провайдер не поддерживает, клиент сам откатится дальше
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT=60
# Повторы при ошибке/таймауте (0 — сразу показать ошибку, а не ждать ещё раз)
LLM_MAX_RETRIES=0
# none — отключить «размышления» у гибридных моделей (qwen3 / qwen3.5 в Ollama); пусто — не передавать
LLM_REASONING_EFFORT=
# Параллельных запросов: 0 — авто (1 для Ollama на одной GPU, 4 для удалённых API)
LLM_CONCURRENCY=0
LLM_MAX_TOKENS=700
# Сколько символов описания отправлять: длинные описания сокращаются до предложений про нужные атрибуты
LLM_MAX_INPUT_CHARS=3500
# Пример ответа в промпте (+~250 токенов на вызов)
LLM_FEW_SHOT=false
# Не спрашивать LLM об атрибутах, о которых в тексте нет ни слова (для чисел — ни одной цифры рядом):
# заземлённо их не извлечь, а вызов стоит денег (на 20 реальных карточках: 18 → 8 вызовов, найденные значения те же)
LLM_PREFILTER=true
# true — зашить справочник допустимых значений в json_schema как enum (по замеру хуже, см. docs/LLM.md)
LLM_SCHEMA_ENUM=false
# Лимиты вызовов: на процесс и на сутки (у ключа организаторов дневной лимит; 0 — без суточного лимита)
LLM_MAX_CALLS=5000
LLM_DAILY_MAX_CALLS=0
# Кэш ответов (повторный прогон бесплатен и воспроизводим)
LLM_CACHE=true

# ML-слой (NER): включается, если обучена модель (attrx train-ner) и установлен extra [ml]
ML_ENABLED=true
ML_MODEL_PATH=models/ner

# Порог, ниже которого значение не идёт в каталог, а уходит на ручную проверку. По умолчанию берётся из
# config/calibration.json (attrx calibrate подбирает его на dev под точность принятых значений ≥ 0,95).
# Явное значение перекрывает калиброванный порог — раскомментируйте, только если это нужно намеренно.
# CONFIDENCE_THRESHOLD=0.7
# Вызывать LLM только если правила не закрыли обязательный атрибут с уверенностью выше этого
LLM_ROUTE_THRESHOLD=0.6

TAXONOMY_PATH=config/taxonomy.yaml
DATASET_CONFIG=config/dataset.yaml
CACHE_PATH=outputs/llm_cache.sqlite
FEEDBACK_PATH=outputs/feedback.jsonl
PREDICTIONS_PATH=outputs/predictions.jsonl

# ---- Сервер ----
# attrx serve по умолчанию слушает только 127.0.0.1; на ВМ хакатона для демо снаружи: ATTRX_HOST=0.0.0.0 (или --host 0.0.0.0)
# ATTRX_HOST=127.0.0.1
# Токен для записи решений модератора (POST /api/feedback*); встроенный UI его не шлёт — на демо не задавать
# ATTRX_TOKEN=
