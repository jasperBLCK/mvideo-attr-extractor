# LLM — любой OpenAI-совместимый endpoint (без VPN):
#   выданный организаторами ключ / GigaChat через gpt2giga / YandexGPT (llm.api.cloud.yandex.net/v1) / vLLM / Ollama
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=changeme
LLM_MODEL=qwen2.5:7b-instruct
# json_schema | json_object | none — как просить у модели строгий JSON
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT=60
LLM_MAX_CALLS=5000

# Порог, ниже которого значение не идёт в каталог, а уходит на ручную проверку
# ML-слой (NER): включается, если обучена модель (attrx train-ner) и установлен extra [ml]
ML_ENABLED=true
ML_MODEL_PATH=models/ner

CONFIDENCE_THRESHOLD=0.7
# Вызывать LLM только если правила не закрыли обязательный атрибут с уверенностью выше этого
LLM_ROUTE_THRESHOLD=0.6

TAXONOMY_PATH=config/taxonomy.yaml
DATASET_CONFIG=config/dataset.yaml
CACHE_PATH=outputs/llm_cache.sqlite
FEEDBACK_PATH=outputs/feedback.jsonl
PREDICTIONS_PATH=outputs/predictions.jsonl
